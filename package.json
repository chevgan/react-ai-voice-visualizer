{
  "name": "react-ai-voice-visualizer",
  "version": "0.1.6",
  "description": "A collection of React components for building AI voice interfaces with real-time audio visualization",
  "type": "module",
  "main": "./dist/react-ai-voice-visualizer.cjs",
  "module": "./dist/react-ai-voice-visualizer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-ai-voice-visualizer.js",
      "require": "./dist/react-ai-voice-visualizer.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/addon-interactions": "^8.4.0",
    "@storybook/addon-links": "^8.4.0",
    "@storybook/blocks": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "storybook": "^8.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3"
  },
  "keywords": [
    "react",
    "ai",
    "voice",
    "audio",
    "visualization",
    "microphone",
    "waveform",
    "voice-activity-detection",
    "vad",
    "web-audio-api",
    "speech",
    "voice-ui",
    "transcription",
    "speech-recognition",
    "ai-assistant"
  ],
  "author": "chevgan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chevgan/react-ai-voice-visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/chevgan/react-ai-voice-visualizer/issues"
  },
  "homepage": "https://github.com/chevgan/react-ai-voice-visualizer#readme"
}
